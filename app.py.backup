st.set_page_config(page_title="Coral Bleaching & Ocean Climate Analysis", layout="wide", initial_sidebar_state="collapsed")

BASE_DIR = Path(__file__).resolve().parent

def find_path(name: str, is_dir: bool = False) -> Path:
    for p in [BASE_DIR / name, Path(name), Path("Users/Ravi/Documents/Visualising Data/project") / name, Path.home() / "Documents/Visualising Data/project" / name]:
        if p.is_dir() if is_dir else p.exists():
            return p
    return BASE_DIR / name

IMAGE_ROOT = find_path("images", is_dir=True)

