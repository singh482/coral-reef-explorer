@st.cache_data(show_spinner=False)
def load_all_datasets():
    df_global, df_regional, df_climate = None, None, None

    g_path = find_path("global_bleaching_environmental.csv")
    if not g_path.exists():
        g_path = find_path("coral.csv")
    if g_path.exists():
        df_global = pd.read_csv(g_path, low_memory=False)
        for col in ["Percent_Bleaching", "Depth_m", "SSTA", "SSTA_DHW", "Temperature_Mean", "Temperature_Maximum", "Turbidity", "Windspeed", "Distance_to_Shore", "Cyclone_Frequency", "Latitude_Degrees", "Longitude_Degrees", "Date_Year", "Date_Month"]:
            if col in df_global.columns:
                df_global[col] = pd.to_numeric(df_global[col], errors="coerce")

    r_path = find_path("coral_bleaching.csv")
    if r_path.exists():
        df_regional = pd.read_csv(r_path, low_memory=False)
        for col in ["Year", "Temperature_Celsius", "SSTA", "DHW_Stress", "Hotspot", "ONI_Index", "Chlorophyll_A_mg_m3", "Bleaching_Percent", "Salinity", "Dissolved_O2", "pH", "Nitrate", "Distance_to_Shore_km", "NDVI", "Turbidity_NTU"]:
            if col in df_regional.columns:
                df_regional[col] = pd.to_numeric(df_regional[col], errors="coerce")

    c_path = find_path("realistic_ocean_climate_dataset.csv")
    if c_path.exists():
        df_climate = pd.read_csv(c_path, low_memory=False)
        for col in ["SST (°C)", "pH Level", "Species Observed"]:
            df_climate[col] = pd.to_numeric(df_climate[col], errors="coerce")
        df_climate["Severity_Clean"] = df_climate["Bleaching Severity"].fillna("None")
        df_climate["Heatwave_Num"] = df_climate["Marine Heatwave"].astype(int)

    return df_global, df_regional, df_climate

def find_stage_photo(stage_name: str):
    valid_exts = {".jpg", ".jpeg", ".png", ".webp"}
    if IMAGE_ROOT.is_dir():
        for f in sorted(IMAGE_ROOT.iterdir()):
            if f.is_file() and f.stem.lower() == stage_name.lower() and f.suffix.lower() in valid_exts:
                try:
                    return Image.open(f).convert("RGB"), f
                except Exception:
                    pass
        for sub in sorted(IMAGE_ROOT.iterdir()):
            if sub.is_dir() and sub.name.lower() == stage_name.lower():
                for f in sorted(sub.iterdir()):
                    if f.is_file() and f.suffix.lower() in valid_exts:
                        try:
                            return Image.open(f).convert("RGB"), f
                        except Exception:
                            pass
    return None, None

def blend_coral_stages(progress_pct: int, img_healthy: Image.Image, img_bleached: Image.Image, img_dead: Image.Image) -> Image.Image:
    b = img_bleached.resize(img_healthy.size, Image.Resampling.LANCZOS)
    d = img_dead.resize(img_healthy.size, Image.Resampling.LANCZOS)
    return Image.blend(img_healthy, b, progress_pct / 50.0) if progress_pct <= 50 else Image.blend(b, d, (progress_pct - 50) / 50.0)

PALETTE = {"healthy": "#4c9a8a", "watch": "#d4a359", "bleached": "#c95b4b", "dead": "#73302a", "cool": "#4f83a3", "neutral": "#7b8c98"}
AXIS_STYLE = dict(gridcolor="rgba(255, 255, 255, 0.07)", zerolinecolor="rgba(255, 255, 255, 0.12)", linecolor="rgba(255, 255, 255, 0.15)")

def make_layout(**overrides):
    return {**dict(template="plotly_dark", paper_bgcolor="rgba(15, 23, 30, 0)", plot_bgcolor="#15202b", font=dict(family="Inter, sans-serif", color="#d6dde2", size=12), margin=dict(l=55, r=35, t=42, b=55)), **overrides}

def section_header(anchor: str, tag: str, title: str):
    st.markdown(f'<div id="{anchor}" class="section-anchor"></div><div class="section-tag">{tag}</div><h2>{title}</h2>', unsafe_allow_html=True)

def render_explanation(context: str, description: str, conclusion: str):
    st.markdown(f'<div class="narrative-box"><p><span class="narrative-label">1. Context &amp; Data Source:</span> {context}</p><p><span class="narrative-label">2. Description &amp; Methodology:</span> {description}</p><p><span class="narrative-label">3. Conclusion &amp; Critical Assessment:</span> {conclusion}</p></div>', unsafe_allow_html=True)

def add_linear_trend(fig, x_vals, y_vals, color="#d4a359", name="Linear Trend"):
    x, y = np.asarray(x_vals, dtype=float), np.asarray(y_vals, dtype=float)
    valid = np.isfinite(x) & np.isfinite(y)
    if valid.sum() >= 5:
        slope, intercept = np.polyfit(x[valid], y[valid], 1)
        x_line = np.linspace(np.nanmin(x[valid]), np.nanmax(x[valid]), 100)
        fig.add_trace(go.Scatter(x=x_line, y=slope * x_line + intercept, mode="lines", line=dict(color=color, width=2, dash="dash"), name=name, hoverinfo="skip"))

df_global, df_regional, df_climate = load_all_datasets()

st.markdown("# Global and Regional Coral Reef Bleaching Analysis")
st.markdown("<p style='color:#8fa1ad;font-size:0.96rem;margin-top:-4px;margin-bottom:18px;'>An integrated visual investigation of thermal stress, El Nino climate cycles, ocean acidification, and biological reef degradation across four multi-scale datasets (1980–2026).</p>", unsafe_allow_html=True)

m1, m2, m3, m4 = st.columns(4)
m1.metric("Global Reef Surveys", f"{len(df_global):,}" if df_global is not None else "Missing", "1980–2020 (global_bleaching_environmental)")
